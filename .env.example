# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database Configuration (MySQL)
# Default MySQL connection:
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=linux_learning_assistant

# Or direct DATABASE_URL connection string:
# DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/linux_learning_assistant
# If MySQL is not reachable, app automatically falls back to local sqlite database for instant testing.

# Mail Configuration (Gmail SMTP for verification)
# To use real Gmail verification, set your App Password:
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_gmail_app_password
MAIL_DEFAULT_SENDER=your_gmail_address@gmail.com

# In development mode, verification tokens and codes are also shown on-screen / in logs
DEV_MODE_AUTO_VERIFY=False
